<Application x:Class="Arcanum.Launcher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Application.Resources>
<SolidColorBrush x:Key="Gold" Color="#C6A66A"/>
<Style TargetType="Button"><Setter Property="Foreground" Value="#F6EDE0"/><Setter Property="Background" Value="#30233F"/><Setter Property="BorderBrush" Value="#8C744D"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#EAC985"/><Setter TargetName="Frame" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEE5D7"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#171322"/><Setter Property="Foreground" Value="#F6EDE0"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#786145"/><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EEE5D7"/><Setter Property="Margin" Value="0,12"/></Style>
</Application.Resources></Application>
