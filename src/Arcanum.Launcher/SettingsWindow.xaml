<Window x:Class="Arcanum.Launcher.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Paramètres d’Arcanum" Width="620" Height="650" MinWidth="550" MinHeight="500" Background="#171322" WindowStartupLocation="CenterOwner">
<ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26"><TextBlock Text="Paramètres du launcher" FontFamily="Georgia" FontSize="25" Foreground="#C6A66A" Margin="0,0,0,20"/><TextBlock Text="Propriétaire du dépôt GitHub"/><TextBox x:Name="OwnerBox"/><TextBlock Text="Nom du dépôt public"/><TextBox x:Name="RepoBox"/><TextBlock Text="Dossier dédié au jeu"/><TextBox x:Name="PathBox"/><TextBlock Text="Changer ce chemin ne déplace pas l’installation existante. Choisissez un dossier vide pour une nouvelle installation." TextWrapping="Wrap" FontSize="12"/><CheckBox x:Name="AutoBox" Content="Vérifier et installer les mises à jour au démarrage"/><TextBlock Text="Launcher 1.0.0 · Français · Canal stable" Foreground="#B5A4C7" Margin="0,8"/><WrapPanel><Button Content="Dossier du jeu" Click="OpenGame"/><Button Content="Journaux" Click="OpenLogs"/></WrapPanel><TextBlock Text="Mise à jour du launcher : fermez-le puis remplacez son dossier par la nouvelle distribution officielle. Le dossier Game et les paramètres restent séparés." TextWrapping="Wrap" Margin="0,16"/><Button Content="Enregistrer" Click="Save" HorizontalAlignment="Right"/></StackPanel></ScrollViewer></Window>
