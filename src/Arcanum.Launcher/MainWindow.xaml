<Window x:Class="Arcanum.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Projet Arcanum — Launcher" Width="1000" Height="650" MinWidth="840" MinHeight="600" Background="#100E1C" Foreground="#EEE5D7" WindowStartupLocation="CenterScreen">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="◈" FontSize="40" Foreground="{StaticResource Gold}" Margin="0,0,14,0"/><StackPanel><TextBlock Text="PROJET ARCANUM" FontFamily="Georgia" FontSize="26" Foreground="{StaticResource Gold}"/><TextBlock Text="{Binding InstalledLabel}" FontSize="12" Margin="0,5,0,0" Foreground="#B5A4C7"/></StackPanel></StackPanel><Button Grid.Column="1" Content="⚙  Paramètres" Click="SettingsClick" IsEnabled="{Binding NotBusy}"/></Grid>
<Grid Grid.Row="1" Margin="0,22,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border BorderBrush="#755E43" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><Grid><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#322348"/><GradientStop Color="#101C32" Offset="1"/></LinearGradientBrush></Grid.Background>
<Image Source="{Binding BackgroundImage}" Stretch="UniformToFill" Opacity="0.5"/>
<Viewbox Margin="35,15,35,95" Stretch="Uniform"><Canvas Width="320" Height="280"><Ellipse Width="260" Height="260" Stroke="#70618D" StrokeThickness="1" Canvas.Left="30" Canvas.Top="10"/><Ellipse Width="225" Height="225" Stroke="#4C426A" Canvas.Left="47" Canvas.Top="27"/>
<Border Width="125" Height="177" Background="#15263D" BorderBrush="#A58A5D" BorderThickness="2" CornerRadius="8" Canvas.Left="49" Canvas.Top="51" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="-20"/></Border.RenderTransform><TextBlock Text="✧" FontSize="82" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B9A16C"/></Border>
<Border Width="125" Height="177" Background="#352449" BorderBrush="#D7B578" BorderThickness="2" CornerRadius="8" Canvas.Left="145" Canvas.Top="51" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="17"/></Border.RenderTransform><TextBlock Text="◈" FontSize="72" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#E2BF7D"/></Border><TextBlock Text="✦" FontSize="24" Canvas.Left="148" Canvas.Top="1" Foreground="#E2BF7D"/></Canvas></Viewbox>
<StackPanel VerticalAlignment="Bottom" Margin="25"><TextBlock Text="La prochaine main&#10;écrit votre légende." FontFamily="Georgia" FontSize="27"/><TextBlock Text="DES CARTES · DES HISTOIRES · DES LÉGENDES" FontSize="10" Foreground="#C6A66A" Margin="0,13,0,0"/></StackPanel></Grid></Border>
<Border Grid.Column="2" Background="#191525" BorderBrush="#45374F" BorderThickness="1" CornerRadius="12" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="LE GRIMOIRE DES NOUVEAUTÉS" Foreground="{StaticResource Gold}" FontSize="12"/><TextBlock Grid.Row="1" Text="{Binding LatestLabel}" FontFamily="Georgia" FontSize="24" Margin="0,12,0,18"/><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="14" LineHeight="23"/></ScrollViewer></Grid></Border></Grid>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13"/><ProgressBar Value="{Binding Percent}" Maximum="100" Height="6" Foreground="#B89A62" Background="#30273F" BorderThickness="0" Margin="0,10,0,5"/><TextBlock Text="{Binding ProgressLabel}" FontSize="11" Foreground="#B5A4C7"/><StackPanel Orientation="Horizontal"><Button Content="Vérifier" Command="{Binding CheckCommand}" Padding="10,5"/><Button Content="Annuler" Command="{Binding CancelCommand}" Padding="10,5"/><TextBlock Text="{Binding LastCheck}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#B5A4C7"/></StackPanel></StackPanel><StackPanel Grid.Column="1"><Button Content="{Binding ActionLabel}" Command="{Binding PrimaryCommand}" Background="#67418D" FontSize="23" FontFamily="Georgia" Padding="20,17"/><TextBlock Text="LAUNCHER 1.0.0  ·  CANAL STABLE" HorizontalAlignment="Center" FontSize="10" Foreground="#B5A4C7" Margin="0,7,0,0"/></StackPanel></Grid>
</Grid></Window>
